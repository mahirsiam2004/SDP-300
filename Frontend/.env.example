# ShopFlare Frontend environment (Expo reads EXPO_PUBLIC_* at build time).
# Copy to .env and set the values for your machine. .env is gitignored.

# Base API URL used by the app. On a physical device (APK / Expo Go on phone)
# this MUST be your computer's LAN IP, not localhost (localhost = the phone itself).
# Web / emulator can keep http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://192.168.0.108:8000/api

# Demand-predictor ML server (separate Django project on :8001). Same LAN-IP rule.
EXPO_PUBLIC_AI_PREDICTION_URL=http://192.168.0.108:8001/api/weekly-prediction/
