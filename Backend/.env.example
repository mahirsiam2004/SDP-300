# ShopFlare Backend environment (Django reads these via auth/settings.py).
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Only non-secret keys are listed here as a template.

DEBUG=True
USE_POSTGRES=True
USE_SQLITE=False
DB_NAME=shopflare
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# Email (left unconfigured in dev -> send_mail fails silently, flow still works)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@shopflare.com

# SSLCommerz (sandbox demo credentials; your own store is deactivated)
SSL_STORE_ID=testbox
SSL_IS_SANDBOX=True
SSL_PAYMENT_VERIFY_ENABLED=False
SSL_INIT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATE_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_SUCCESS_URL=http://localhost:8000/api/auth/payment/ssl/success/
SSL_FAIL_URL=http://localhost:8000/api/auth/payment/ssl/fail/
SSL_CANCEL_URL=http://localhost:8000/api/auth/payment/ssl/cancel/
SSL_IPN_URL=http://localhost:8000/api/auth/payment/ssl/ipn/
APP_SUCCESS_URL=shopflare://orderDetail
APP_FAIL_URL=shopflare://cart
APP_CANCEL_URL=shopflare://cart

# Demand-predictor ML server (separate project on :8001). Use your LAN IP for
# physical-device access, or localhost when the app runs on the same machine.
AI_PREDICTION_URL=http://localhost:8001/api/weekly-prediction/
